{
  "name": "planlayer-frontend",
  "private": true,
  "version": "0.5.2",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings && node scripts/check-inputs.mjs",
    "preview": "vite preview",
    "gen:api": "uv run --project ../backend planlayer api-types src/schema.ts"
  },
  "dependencies": {
    "@revolist/react-datagrid": "4.31.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
