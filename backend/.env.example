# Local development against `docker compose up db`. Copy to backend/.env.
PLANLAYER_ENVIRONMENT=development
PLANLAYER_APP_DATABASE_URL=postgresql+psycopg://planlayer:planlayer@localhost:5432/planlayer
PLANLAYER_SOURCE_DATABASE_URL=postgresql+psycopg://planlayer:planlayer@localhost:5432/dwh
PLANLAYER_OUTPUT_DATABASE_URL=postgresql+psycopg://planlayer:planlayer@localhost:5432/dwh

# Tests read this from the shell environment (export it), not from .env. They create and drop
# their own schemas, so they need a role that may create schemas.
# PLANLAYER_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
