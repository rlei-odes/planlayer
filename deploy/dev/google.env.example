# Google Workspace for the "google" test installation (docs/google-workspace.md).
# Copy to deploy/dev/google.env (git-ignored), fill in the values, then:
#   docker compose --profile google up -d --build app-google
# and open http://localhost:8003.

# Required: the OAuth client's secret.
PLANLAYER_OIDC_CLIENT_SECRET=

# --- Optional: the login set by the environment instead of the Settings page ---------------------
# Left as it is, you enter these on Settings › Login and use Test there. With the next line
# uncommented, the environment sets the login and the page shows it read-only (Test still works).
#PLANLAYER_LOGIN_METHOD=oidc
PLANLAYER_LOGIN_OIDC_LABEL=Google
PLANLAYER_LOGIN_OIDC_ISSUER=https://accounts.google.com
# The OAuth client's ID (….apps.googleusercontent.com).
PLANLAYER_LOGIN_OIDC_CLIENT_ID=<Client ID>
# The Workspace's domain: only its accounts log in (the hd claim).
PLANLAYER_LOGIN_OIDC_HOSTED_DOMAIN=<domain>
# Google sends no preferred_username.
PLANLAYER_LOGIN_OIDC_LOGIN_CLAIM=email
