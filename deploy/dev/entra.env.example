# Microsoft Entra ID for the "entra" test installation (docs/entra-id.md).
# Copy to deploy/dev/entra.env (git-ignored), fill in the values, then:
#   docker compose --profile entra up -d --build app-entra
# and open http://localhost:8001.

# Required: the client secret's Value (Certificates & secrets), not its Secret ID.
PLANLAYER_OIDC_CLIENT_SECRET=

# --- Optional: the login set by the environment instead of the Settings page ---------------------
# Left as it is, you enter these on Settings › Login and use Test there. With the next line
# uncommented, the environment sets the login and the page shows it read-only (Test still works).
#PLANLAYER_LOGIN_METHOD=oidc
PLANLAYER_LOGIN_OIDC_LABEL=Microsoft
# Directory (tenant) ID, from the app registration's Overview.
PLANLAYER_LOGIN_OIDC_ISSUER=https://login.microsoftonline.com/<Directory (tenant) ID>/v2.0
# Application (client) ID, from the same page.
PLANLAYER_LOGIN_OIDC_CLIENT_ID=<Application (client) ID>
# Roles by app role name (docs/entra-id.md, "By name, with app roles"): the claim and the values.
PLANLAYER_LOGIN_OIDC_GROUPS_CLAIM=roles
PLANLAYER_LOGIN_ADMIN_GROUP=Planlayer.Admin
PLANLAYER_LOGIN_CONTROLLER_GROUP=Planlayer.Controller
# Or by group: drop the claim line above and put the groups' Object IDs (Groups › the group ›
# Overview) in the two lines instead. Empty: the role is set on the Users page.
