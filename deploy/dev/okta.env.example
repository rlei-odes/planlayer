# Okta for the "okta" test installation (docs/okta.md).
# Copy to deploy/dev/okta.env (git-ignored), fill in the values, then:
#   docker compose --profile okta up -d --build app-okta
# and open http://localhost:8002.

# Required: the app's Client secret (General tab).
PLANLAYER_OIDC_CLIENT_SECRET=

# --- Optional: the login set by the environment instead of the Settings page ---------------------
# Commented out, they are only values to copy into Settings › Login. Uncommented with the method
# line, the environment sets the login and the page shows it read-only (Test still works).
#PLANLAYER_LOGIN_METHOD=oidc
#PLANLAYER_LOGIN_OIDC_LABEL=Okta
# The org's address, without -admin.
#PLANLAYER_LOGIN_OIDC_ISSUER=https://<org>.okta.com
# Client ID, from the app's General tab.
#PLANLAYER_LOGIN_OIDC_CLIENT_ID=<Client ID>
# The org authorization server sends the groups claim only for the groups scope (docs/okta.md).
#PLANLAYER_LOGIN_OIDC_SCOPES=openid profile email groups
# Role groups by name. Empty: the role is set on the Users page.
#PLANLAYER_LOGIN_ADMIN_GROUP=Planlayer Admins
#PLANLAYER_LOGIN_CONTROLLER_GROUP=Planlayer Controllers
