# Planlayer's settings (docs/install.md). Copy to planlayer.env next to compose.yaml and fill in.
# Passwords: letters and digits only (e.g. openssl rand -hex 24), as they stand inside URLs.

# --- Connections (T-14) ---------------------------------------------------------------------------
# The app store. With the bundled Postgres (profile postgres), host db; the first start creates
# the database and the role with this name and password.
PLANLAYER_APP_DATABASE_URL=postgresql+psycopg://planlayer:<password>@db/planlayer
# The warehouse Planlayer reads (the source views) and writes the published output to. Unset:
# the app store's database.
#PLANLAYER_SOURCE_DATABASE_URL=postgresql+psycopg://planlayer:<password>@dwh.example.com/dwh
#PLANLAYER_OUTPUT_DATABASE_URL=postgresql+psycopg://planlayer:<password>@dwh.example.com/dwh

# --- Pay encryption (ADR 0029) --------------------------------------------------------------------
# Encrypts salaries and the login's client secret. Make it once with
#   docker compose run --rm --no-deps app planlayer new-pay-key
# and keep a copy where only those who may read pay reach it (HR's password manager), apart from
# the backups. A lost key loses the encrypted salaries.
PLANLAYER_PAY_KEY=<planlayer new-pay-key>

# --- Backups (ADR 0032) ---------------------------------------------------------------------------
# The backup role reads the whole app store; the install script creates it (backup_password).
# With the bundled Postgres, the first start creates it with this name and password.
PLANLAYER_BACKUP_DATABASE_URL=postgresql://planlayer_backup:<password>@db/planlayer
# How many backups to keep in the backups volume.
#PLANLAYER_BACKUP_KEEP=14

# --- Address --------------------------------------------------------------------------------------
# The address users open, behind the reverse proxy; the OpenID Connect callback is under it.
PLANLAYER_PUBLIC_URL=https://plan.example.com

# --- Login (docs/login.md) ------------------------------------------------------------------------
# Set up on the Settings page, or here: the page shows the lines after a passing test.
#PLANLAYER_OIDC_CLIENT_SECRET=
