# What compose.yaml itself needs (docs/install.md). Copy to .env next to it.
# Planlayer's own settings are in planlayer.env.

# The image version: a minor version receives its patch releases on docker compose pull.
PLANLAYER_VERSION=0.5
# Where the container listens; the reverse proxy forwards to it.
PLANLAYER_LISTEN=127.0.0.1:8000

# --- Bundled Postgres only ------------------------------------------------------------------------
#COMPOSE_PROFILES=postgres
#POSTGRES_PASSWORD=
